{
  "name": "polaris-workspace",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "polaris:start": "corepack pnpm --filter polaris build && node packages/cli/dist/bin.js start",
    "polaris:stop": "node packages/cli/dist/bin.js stop",
    "polaris:status": "node packages/cli/dist/bin.js status",
    "dev": "node scripts/dev/start.mjs",
    "dev:core": "corepack pnpm --filter @polaris/core dev",
    "dev:mcp": "node scripts/mcp-stdio.mjs --watch",
    "dev:console": "corepack pnpm --filter @polaris/console dev",
    "dev:extension": "corepack pnpm --filter @polaris/extension dev",
    "mcp": "node scripts/mcp-stdio.mjs",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "test:smoke": "node scripts/dev/smoke-v1.mjs",
    "test:e2e": "playwright test",
    "test:e2e:baseline": "playwright test --update-snapshots",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:page": "node scripts/e2e/page-visual.mjs",
    "test:e2e:page:baseline": "node scripts/e2e/page-visual.mjs --update",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "verify:v1": "corepack pnpm typecheck && corepack pnpm build && node scripts/dev/smoke-v1.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
